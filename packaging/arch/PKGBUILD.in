pkgname=cockpit-share-control
pkgver=VERSION
pkgrel=1
pkgdesc='Cockpit module for managing Samba shares from a declarative access matrix'
arch=('x86_64')
url='https://github.com/1AUSFfM/cockpit-share-control'
license=(LGPL)
source=("SOURCE")
sha256sums=('SKIP')

package() {
  depends=(cockpit)
  cd $pkgname
  make DESTDIR="$pkgdir" install PREFIX=/usr
}
